    <!-- Settings -->
    <string name="settings_appearance">Appearance</string>
    <string name="settings_appearance_help">Follow your phone, or always use one look.</string>
    <string name="appearance_system">Same as my phone</string>
    <string name="appearance_night">Night</string>
    <string name="appearance_day">Day</string>
    <string name="settings_reduce_motion">Reduce motion</string>
    <string name="settings_reduce_motion_help">No gentle glow pulse and no sliding in. Changes happen at once.</string>
    <string name="settings_notifications_off_title">Notifications are off</string>
    <string name="settings_quality">Quality</string>
    <string name="settings_quality_help">Used for every new download.</string>
    <string name="settings_concurrency">Downloads at the same time</string>
    <string name="settings_concurrency_help">More is faster, but uses more battery and data at once. Pick 1 to 5.</string>
    <string name="settings_concurrency_fewer">Fewer downloads at the same time</string>
    <string name="settings_concurrency_more">More downloads at the same time</string>
    <string name="settings_concurrency_value">%1$d at the same time</string>
    <string name="settings_speed">Speed limit</string>
    <string name="settings_speed_label">Speed limit per download</string>
    <string name="settings_speed_help">Leave empty for no limit. Examples: 500K or 2M (per second).</string>
    <string name="settings_speed_invalid">Not saved yet. Use a number with a capital K, M or G, like 2M or 500K, or leave it empty.</string>
    <string name="settings_accounts">Accounts</string>
    <string name="settings_accounts_help">Needed for Instagram stories and private posts. Elisium only uses the cookies for the site you download from.</string>
    <string name="settings_accounts_none">No cookies imported.</string>
    <plurals name="settings_accounts_imported">
        <item quantity="one">Imported (%1$d cookie)</item>
        <item quantity="other">Imported (%1$d cookies)</item>
    </plurals>
    <string name="settings_accounts_import">Import cookies.txt</string>
    <string name="settings_accounts_import_for">Pick a cookies.txt file exported on a computer</string>
    <string name="settings_accounts_remove">Remove</string>
    <string name="settings_accounts_remove_for">Remove the imported cookies</string>
    <string name="settings_accounts_empty">That file has no cookies in it. Sign in to the site in your browser, export cookies.txt again, then pick the new file.</string>
    <string name="settings_accounts_wrong_format">That file is not a cookies.txt file. Export one with a cookies.txt browser extension on a computer, then copy it to this phone.</string>
    <string name="settings_accounts_how">How to get the file: on a computer, add a cookies.txt extension to your browser, sign in to Instagram there, export the cookies for instagram.com, then copy the file to this phone and pick it here. The file stays on this phone and is never included in a backup.</string>
    <string name="settings_network">Network and alerts</string>
    <string name="settings_wifi_only">Wi-Fi only</string>
    <string name="settings_wifi_only_help">Wait for an unmetered Wi-Fi network instead of using mobile data or a metered Wi-Fi.</string>
    <string name="settings_notify">Tell me when downloads finish</string>
    <string name="settings_notify_help">Shows one notification when the list is done.</string>
    <string name="settings_notifications_off">Notifications are off for Elisium, so you will not be told when downloads finish. Downloads still work.</string>
    <string name="settings_notifications_open">Open notification settings</string>
