    <string name="banner_wifi_title">Waiting for Wi-Fi</string>
    <string name="banner_wifi_body">Downloads will start when you connect to a Wi-Fi network that is not metered. A hotspot or a Wi-Fi marked as metered counts as mobile data. To download anyway, turn off Wi-Fi only in Settings.</string>
    <string name="banner_service_title">Downloads may stop if you leave the app</string>
    <string name="banner_service_body">Android would not let Elisium keep running in the background. Keep the app open until the downloads finish. Detail: %1$s</string>

